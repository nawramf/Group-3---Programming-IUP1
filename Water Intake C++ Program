#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

// Struct untuk menyimpan data aplikasi Water Intake
struct WaterIntakeApp {
    // Data Pengguna
    double weight = 0.0;
    bool isTropical = false; // Weather: true = Tropis, false = Subtropis
    int activityChoice = 0;   // 1: Ringan, 2: Sedang, 3: Berat

    // Data Perhitungan
    double dailyTargetMl = 0.0;
    double currentProgressMl = 0.0;

    // Data Streak & Pengingat
    int streakCount = 0;
    int reminderIntervalHours = 2; // Pengingat minum setiap 2 jam
};

// Fungsi 1: Water Intake Calculator
void calculateWaterTarget(WaterIntakeApp &app) {
    // Rumus dasar: Berat Badan (kg) * 35 ml
    double baseWater = app.weight * 35.0;
    double totalWater = baseWater;

    // Faktor Weather (Boolean)
    if (app.isTropical) {
        totalWater += 500.0; // Iklim Tropis (+500 ml)
    } else {
        totalWater += 200.0; // Iklim Subtropis (+200 ml)
    }

    // Faktor Aktivitas
    if (app.activityChoice == 2) {
        totalWater += 350.0; // Aktivitas Sedang
    } else if (app.activityChoice == 3) {
        totalWater += 700.0; // Aktivitas Berat
    }

    app.dailyTargetMl = totalWater;
}

// Fungsi 2: Water Intake Reminder & Drink Logger
void logWaterDrink(WaterIntakeApp &app) {
    double drinkAmount = 0.0;
    cout << "\n------------------------------------------" << endl;
    cout << "          LOG WATER INTAKE / DRINK        " << endl;
    cout << "------------------------------------------" << endl;
    cout << "Masukkan jumlah air yang diminum (ml): ";
    cin >> drinkAmount;

    if (drinkAmount <= 0) {
        cout << "[!] Jumlah air tidak valid!" << endl;
        return;
    }

    app.currentProgressMl += drinkAmount;
    cout << "[+] Berhasil mencatat " << drinkAmount << " ml air." << endl;

    // Cek Progres & Cek Pemenuhan Target
    if (app.currentProgressMl >= app.dailyTargetMl) {
        cout << "\n==========================================" << endl;
        cout << " [!] SELAMAT! Target harian Anda tercapai!" << endl;
        cout << "==========================================" << endl;
        app.streakCount++; // Menambah streak jika target tercapai
        cout << " Streak harian Anda bertambah menjadi: " << app.streakCount << " Hari 🔥" << endl;
    } else {
        double sisa = app.dailyTargetMl - app.currentProgressMl;
        cout << "\n------------------------------------------" << endl;
        cout << " [NOTIFIKASI REMINDER]                    " << endl;
        cout << " Ingat untuk minum air lagi " << app.reminderIntervalHours << " jam dari sekarang!" << endl;
        cout << " Sisa target minum hari ini: " << sisa << " ml (~" << (int)(sisa / 250) << " gelas)" << endl;
        cout << "------------------------------------------" << endl;
    }
}

// Fungsi 3: Water Streak & Status Dashboard
void displayDashboard(const WaterIntakeApp &app) {
    cout << "\n==========================================" << endl;
    cout << "         WATER INTAKE DASHBOARD           " << endl;
    cout << "==========================================" << endl;
    cout << fixed << setprecision(1);
    cout << " Status Iklim     : " << (app.isTropical ? "Tropis (true)" : "Subtropis (false)") << endl;
    cout << " Target Harian   : " << app.dailyTargetMl << " ml (" << app.dailyTargetMl / 1000.0 << " Liter)" << endl;
    cout << " Terkumpul Saat Ini: " << app.currentProgressMl << " ml" << endl;
    cout << " Progres Harian  : " << (app.currentProgressMl / app.dailyTargetMl) * 100.0 << " %" << endl;
    cout << " Water Streak    : " << app.streakCount << " Hari 🔥" << endl;
    cout << "==========================================" << endl;
}

int main() {
    WaterIntakeApp app;
    int climateChoice = 0;

    cout << "==========================================" << endl;
    cout << "      SETUP WATER INTAKE CALCULATOR       " << endl;
    cout << "==========================================" << endl;

    // Input Berat Badan
    cout << "Masukkan Berat Badan (kg): ";
    cin >> app.weight;

    // Input Weather (Boolean)
    cout << "\nPilih Iklim Tempat Tinggal:" << endl;
    cout << "1. Tropis" << endl;
    cout << "2. Subtropis" << endl;
    cout << "Pilihan (1/2): ";
    cin >> climateChoice;
    app.isTropical = (climateChoice == 1); // Jika 1 = true, selain itu false

    // Input Aktivitas Harian
    cout << "\nPilih Tingkat Aktivitas Harian:" << endl;
    cout << "1. Ringan" << endl;
    cout << "2. Sedang" << endl;
    cout << "3. Berat" << endl;
    cout << "Pilihan (1-3): ";
    cin >> app.activityChoice;

    // Hitung Target Awal
    calculateWaterTarget(app);

    int menuChoice = 0;
    do {
        cout << "\n==========================================" << endl;
        cout << "            MENU UTAMA APLIKASI           " << endl;
        cout << "==========================================" << endl;
        cout << "1. Liht Dashboard & Streak Tracker" << endl;
        cout << "2. Catat Minum Air (Input Progress & Reminder)" << endl;
        cout << "3. Reset Hari Baru (Simpan/Cek Streak)" << endl;
        cout << "4. Keluar" << endl;
        cout << "Pilih menu (1-4): ";
        cin >> menuChoice;

        switch (menuChoice) {
            case 1:
                displayDashboard(app);
                break;
            case 2:
                logWaterDrink(app);
                break;
            case 3:
                cout << "\n[!] Memulai Hari Baru..." << endl;
                if (app.currentProgressMl < app.dailyTargetMl) {
                    cout << "[!] Target kemarin tidak tercapai. Streak di-reset ke 0." << endl;
                    app.streakCount = 0;
                }
                app.currentProgressMl = 0.0;
                cout << "[+] Progres harian di-reset ke 0 ml." << endl;
                break;
            case 4:
                cout << "\nTerima kasih telah menggunakan aplikasi Water Intake!" << endl;
                break;
            default:
                cout << "\n[!] Pilihan menu tidak valid." << endl;
        }
    } while (menuChoice != 4);

    return 0;
}
